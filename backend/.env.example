# ─────────────────────────────────────────────────────────────
# Backend environment variables
#
# LOCAL DEV:  copy this file to `.env` and fill in real values.
# AZURE:      do NOT deploy a .env file. Set each of these in
#             App Service → Settings → Configuration → Application settings.
# ─────────────────────────────────────────────────────────────

# Port the server listens on.
# Local: 3001. Azure App Service injects its own PORT — LEAVE BLANK in Azure.
PORT=3001

# AI provider keys
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# BigQuery (service-account auth — required when running off-GCP, e.g. Azure)
# Create a service account in GCP with roles: BigQuery Data Viewer + Job User.
BQ_PROJECT_ID=data-practice-472314
BQ_DATASET=report_hub_demo
BQ_CLIENT_EMAIL=
# Paste the full key. Keep the \n escapes literal — the code converts them to
# real newlines at runtime. Wrap the whole value in double quotes.
BQ_PRIVATE_KEY=""

# Access gate — credentials checked server-side by POST /api/auth/verify.
# Two roles, each bound to an LLM provider:
#   internal user → Gemma API
#   client user   → Sonnet (via the local `claude` CLI until a Sonnet API key exists)
# Each login requires BOTH username and password.
INTERNAL_USERNAME=internal
INTERNAL_PASSWORD=internal123
CLIENT_USERNAME=client
CLIENT_PASSWORD=client123

# Legacy single-password gate — still works, maps to the internal (Gemma) role.
# Leave blank if using the INTERNAL_/CLIENT_ pairs above.
ACCESS_PASSWORD=

# Sonnet model alias passed to the `claude` CLI (default: "sonnet" = latest).
SONNET_MODEL=sonnet

# CORS — the frontend origin allowed to call this backend.
# Local: leave blank (defaults to "*"). Azure: set to the Static Web App URL,
# e.g. https://<your-frontend>.azurestaticapps.net
FRONTEND_ORIGIN=
