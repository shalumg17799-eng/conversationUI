# Frontend build-time vars (Vite). Copy to .env.local for dev.
# AZURE Static Web Apps: set VITE_API_URL as a build-time / app setting.

# Backend base URL. Local: blank (defaults to http://localhost:3001).
# Azure: https://<your-backend>.azurewebsites.net
VITE_API_URL=

# ElevenLabs TTS — narration for the report → video feature (client-side).
# NOTE: exposed in the browser bundle; use a restricted key for demos.
VITE_ELEVENLABS_KEY=
# Voice to narrate with (default: Rachel / 21m00Tcm4TlvDq8ikWAM).
VITE_ELEVENLABS_VOICE_ID=

# Pixabay API key (server-side) — B-roll footage behind report videos.
PIXABAY_API_KEY=

# ── KAG (Knowledge-Augmented Generation) ─────────────────────────────────────
# Neo4j knowledge graph used to ground table/column routing.
# See docs/KAG_IMPLEMENTATION_PLAN.md. Local: docker compose -f docker-compose.kag.yml up -d
#
# KAG_ENABLED=false keeps the current code path end-to-end — it is the kill switch.
# KAG_SHADOW=true runs retrieval and records it WITHOUT using the result. Leave shadow
# on until /api/metrics/kag reports shadow.agreementRate >= 0.90.
KAG_ENABLED=false
KAG_SHADOW=true

# Local:  bolt://localhost:7687   Aura: neo4j+s://<instance>.databases.neo4j.io
# Azure → Aura requires outbound bolt+s (7687) to be permitted.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Sonnet auth. Leave ANTHROPIC_API_KEY EMPTY to use the Claude Code CLI (subscription)
# instead of the console API - that emptiness is what selects the CLI path.
# The CLI is often NOT on a server process's PATH; VS Code ships it at
#   ~/.vscode/extensions/anthropic.claude-code-<ver>-<plat>/resources/native-binary/claude.exe
CLAUDE_CLI_PATH=
