# Frontend build-time vars (Vite). Copy to .env.local for dev.
# AZURE Static Web Apps: set VITE_API_URL as a build-time / app setting.

# Backend base URL. Local: blank (defaults to http://localhost:3001).
# Azure: https://<your-backend>.azurewebsites.net
VITE_API_URL=

# ElevenLabs TTS — narration for the report → video feature (client-side).
# NOTE: exposed in the browser bundle; use a restricted key for demos.
VITE_ELEVENLABS_KEY=
# Voice to narrate with (default: Rachel / 21m00Tcm4TlvDq8ikWAM).
VITE_ELEVENLABS_VOICE_ID=

# Pixabay API key (server-side) — B-roll footage behind report videos.
PIXABAY_API_KEY=
